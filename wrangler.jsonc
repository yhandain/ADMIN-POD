{
  // Cloudflare Worker — Delivery Discrepancy Report (static assets + Workers AI)
  "name": "admin-pod",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./discrepancy-report",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ai": { "binding": "AI" }
}
